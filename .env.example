APP_ENV=development
AUTH_MODE=development
DATABASE_URL=sqlite:///./bsmart.db
JWT_SECRET=replace-with-at-least-32-random-characters

# External connectors. Never commit real values. Development may run with
# INTEGRATION_MODE=sandbox; production refuses a send/payment unless the
# corresponding provider-issued credentials are present.
INTEGRATION_MODE=sandbox
PUBLIC_APP_URL=http://127.0.0.1:8000

# bKash Tokenized Checkout (merchant onboarding issues these values)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Alpha SMS / sms.net.bd
SMS_BASE_URL=https://api.sms.net.bd
SMS_API_KEY=
SMS_SENDER_ID=

# Anthropic Claude API — L1 Bangla recommendation explanation (api/llm_gateway.py).
# Unset or INTEGRATION_MODE=sandbox: always uses the deterministic template, no call made.
ANTHROPIC_API_KEY=
